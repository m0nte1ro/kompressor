[Unit]
Description=Kompressor Intel GPU encoder worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/kompressor
EnvironmentFile=/etc/kompressor/kompressor.env
ExecStart=/root/kompressor/.venv/bin/python -m app.worker_main qsv
Restart=on-failure
# 2 = configuration error. An unavailable GPU (exit 3, e.g. /dev/dri not ready
# yet after boot) is retried.
RestartPreventExitStatus=2
RestartSec=10
# The worker owns the GPU ffmpeg subprocess and performs bounded termination.
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
